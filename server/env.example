# Modèle de configuration.
#
# Ce fichier-ci EST commité : il documente les variables nécessaires
# sans contenir aucun secret.
#
# Pour l'utiliser : copie-le en ".env" dans ce même dossier, et remplace
# la valeur par ta vraie clé. Le fichier .env, lui, est exclu par .gitignore
# et ne partira jamais sur GitHub.

MISTRAL_API_KEY=colle-ta-cle-ici
